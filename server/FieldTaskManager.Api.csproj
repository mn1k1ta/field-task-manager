<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Angular source lives in the sibling client/ folder; ng build emits into this project's wwwroot. -->
    <SpaRoot>..\client\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
  </ItemGroup>

  <!--
    One-command run: building this project (dotnet run / dotnet build / dotnet publish)
    installs the Angular dependencies (first time only) and builds the SPA straight into wwwroot.
    Disable with -p:SkipSpaBuild=true to iterate on the backend without rebuilding the SPA.
  -->
  <Target Name="EnsureNpmInstall"
          BeforeTargets="BuildSpa"
          Condition="'$(SkipSpaBuild)' != 'true' And !Exists('$(SpaRoot)node_modules')">
    <Message Importance="high" Text="Installing Angular dependencies (npm ci) in $(SpaRoot) ..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
  </Target>

  <Target Name="BuildSpa"
          BeforeTargets="Build"
          Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Importance="high" Text="Building Angular SPA into wwwroot ..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

</Project>
